{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Echo AI",
  "version": "2.0.0",
  "identifier": "ai.nexusecho.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Nexus Echo",
        "url": "index.html#/overlay",
        "width": 720,
        "height": 460,
        "minWidth": 420,
        "minHeight": 160,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "center": true,
        "acceptFirstMouse": true
      },
      {
        "label": "dashboard",
        "title": "Nexus Echo Dashboard",
        "url": "index.html#/dashboard",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.openai.com https://generativelanguage.googleapis.com http://127.0.0.1:11434 http://localhost:11434",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**", "$TEMP/**"] }
    },
    "trayIcon": {
      "id": "nexus-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "Nexus Echo AI"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "Nexus Echo AI",
    "category": "Productivity",
    "shortDescription": "Private stealth AI meeting assistant",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libasound2"] } }
  },
  "plugins": {
    "global-shortcut": {}
  }
}
